# Configuration de la plateforme. Copier en .env, remplir, ne JAMAIS committer le .env.

# Nom affiché dans l'en-tête, les pages et les messages
PLATEFORME_NOM="Plateforme Ivoire Tech"

# preview  : bandeau d'essai, codes de vérification affichés à l'écran, clé éphémère tolérée
# production : bandeau retiré, codes envoyés par email uniquement, clé secrète obligatoire
PLATEFORME_ENV=production

# Clé de signature des sessions. À générer une fois, à garder secrète, à ne pas changer
# sans raison (la changer déconnecte tout le monde) :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PLATEFORME_SECRET=

# Adresse publique, utilisée dans les liens des emails
PLATEFORME_BASE_URL=https://plateforme.exemple.ci

# Dossier des données : base SQLite + fichiers déposés. C'est LE dossier à sauvegarder.
PLATEFORME_DATA=/var/lib/plateforme-ivoire-tech

# Envoi des emails (codes de vérification, réinitialisation de mot de passe).
# Sans ces variables, l'application n'envoie rien : elle journalise les messages dans
# data/courrier-sortant.log, ce qui suffit pour une recette mais pas pour la production.
PLATEFORME_SMTP_HOST=smtp.exemple.ci
PLATEFORME_SMTP_PORT=587
PLATEFORME_SMTP_USER=
PLATEFORME_SMTP_PASSWORD=
PLATEFORME_SMTP_FROM=no-reply@exemple.ci
